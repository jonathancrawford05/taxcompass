# Backend Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_NAME=TaxCompass
DEBUG=False

# Database
DATABASE_URL=postgresql://taxcompass:taxcompass@localhost:5432/taxcompass
DB_ECHO=False

# Vector Store (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=tax_documents

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Azure OpenAI (Optional Fallback)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Security
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption
MASTER_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_ENCRYPTION_KEY

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.jpg,.png

# Rate Limiting
RATE_LIMIT_PER_HOUR=5

# Payment (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@taxcompass.io

# Observability
SENTRY_DSN=
PHOENIX_ENABLED=False
